##############################################################################
# Copy to .env.local for development, and set the same values in the Vercel
# project settings for deployment.
#
#   cp .env.example .env.local
#
# Never commit .env.local. Never expose a value that is not prefixed with
# NEXT_PUBLIC_ to the browser.
##############################################################################

# ---------------------------------------------------------------------------
# Supabase (required)
#
# Project Settings -> API in the Supabase dashboard. For a local stack, run
# `supabase start` and use the URL and keys it prints.
# ---------------------------------------------------------------------------

# Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security completely.
# Used only by server code: deposit verification, rate limiting and
# notification broadcasts. If this key leaks, rotate it immediately in the
# Supabase dashboard — anyone holding it can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site URL (recommended)
#
# Used to build referral links and auth redirect targets. On Vercel this is
# inferred from the deployment when unset, but setting it explicitly avoids
# preview URLs leaking into invitation links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Scheduled deposit verification (required in production)
#
# Protects /api/cron/verify-deposits, which re-checks deposits that are on
# chain but not yet deep enough. The route refuses to run when this is
# unset, so pending deposits would only settle when a user or an operator
# pressed "re-check". Generate one with:
#
#   openssl rand -hex 32
#
# Vercel Cron sends it automatically as `Authorization: Bearer <value>`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Blockchain providers (required for the networks you enable)
#
# Read-only endpoints. No private key belongs in this file or anywhere else
# in the application: withdrawals are signed by a human in an external
# wallet, never by this software.
#
# A network with no configured provider still accepts deposit requests, but
# they stay PENDING until an operator confirms them manually. Verification is
# never faked or assumed.
# ---------------------------------------------------------------------------

# Tron / TRC20. TronGrid serves public reads without a key but rate limits
# aggressively; get a free key at https://www.trongrid.io for anything real.
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# BNB Smart Chain / BEP20. Any JSON-RPC endpoint works.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Ethereum / ERC20.
ETH_RPC_URL=https://eth.llamarpc.com

# Extra EVM chains without a code change. Comma-separated name=url pairs;
# the name must match the `chain` column of the row in supported_networks.
# EVM_RPC_URLS=polygon=https://polygon-rpc.com,arbitrum=https://arb1.arbitrum.io/rpc

# ---------------------------------------------------------------------------
# Integration tests (optional)
#
# The suite in tests/integration is skipped unless all three are set. Point
# them at a disposable database: the tests create and delete users and write
# ledger rows. Never set these to a production project.
# ---------------------------------------------------------------------------
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
